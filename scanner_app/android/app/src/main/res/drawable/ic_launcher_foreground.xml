<?xml version="1.0" encoding="utf-8"?>
<!--
  Tora mark, from the logo deck: a black app tile, a big white T, and one
  small orange tool icon (a sheet with a scan beam) beside the stem.
  Layer order is locked: tile -> tool -> T.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The 100x100 mark, inset into the adaptive-icon safe zone. -->
    <group
        android:translateX="9"
        android:translateY="9"
        android:scaleX="0.9"
        android:scaleY="0.9">
        <!-- Layer 2: the tool, beside the stem and never above the bar. -->
        <path
            android:pathData="M69,50 H79 A2,2 0 0 1 81,52 V66 A2,2 0 0 1 79,68 H69 A2,2 0 0 1 67,66 V52 A2,2 0 0 1 69,50 Z"
            android:strokeColor="#FF7A4E"
            android:strokeWidth="3.2"
            android:strokeLineJoin="miter" />
        <path
            android:pathData="M63,60 L85,60"
            android:strokeColor="#FF7A4E"
            android:strokeWidth="3.2"
            android:strokeLineJoin="miter" />
        <!-- Layer 3: the T, always in front. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M22,26 H78 V42 H58 V78 H42 V42 H22 Z" />
    </group>
</vector>
